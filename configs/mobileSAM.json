{
    "dataset": {
        "dataset_dir": "./datasets/rice_leaf_disease",
        "max_bbox_shift": 20,
        "num_workers": 4
    },
    "model": {
        "checkpoint_path": "./outputs/weights/mobile_sam.pt",
        "checkpoint_prefix": "",
        "type": "vit_t",
        "image_size": 1024,
        "save_path": "./outputs/logs"
    },
    "train": {
        "epochs": 10000,
        "learning_rate": 1e-5,
        "batch_size": 4,
        "val_freq": 5,
        "gradient_accumulation": 1,
        "bf16": false,
        "warmup_step": 250,
        "resume": false
    },
    "visual": {
        "status": true,
        "save_path": "./images",
        "IOU_threshold": 0.5
    },
    "freeze": {
        "freeze_image_encoder": true,
        "freeze_prompt_encoder": true,
        "freeze_mask_decoder": false
    }
}
